<script>
  const carSlides = document.querySelectorAll('#carousel .car-slide');
  const carDotsWrap = document.getElementById('carDots');
  const carCaption = document.getElementById('carCaption');
  const captions = [
    'Visão frontal · lente dupla',
    'Modo noturno colorido ativado',
    'Detalhe das lentes e carcaça IP66'
  ];
  let carIndex = 0;

  carSlides.forEach((_, i) => {
    const d = document.createElement('div');
    d.className = 'car-dot' + (i === 0 ? ' active' : '');
    d.onclick = () => carGo(i);
    carDotsWrap.appendChild(d);
  });

  function carGo(i) {
    carSlides[carIndex].classList.remove('active');
    carDotsWrap.children[carIndex].classList.remove('active');
    carIndex = (i + carSlides.length) % carSlides.length;
    carSlides[carIndex].classList.add('active');
    carDotsWrap.children[carIndex].classList.add('active');
    carCaption.textContent = captions[carIndex];
  }

  function carMove(dir) { carGo(carIndex + dir); }

  let carTimer = setInterval(() => carMove(1), 4500);
  const carouselEl = document.getElementById('carousel');
  carouselEl.addEventListener('mouseenter', () => clearInterval(carTimer));
  carouselEl.addEventListener('mouseleave', () => carTimer = setInterval(() => carMove(1), 4500));

  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('in'); });
  }, { threshold: 0.12 });
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));
</script>

